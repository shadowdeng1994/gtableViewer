# Line endings are a real correctness issue here, not cosmetics:
#   *.bat  - cmd.exe needs CRLF, and a BOM makes it print garbage
#   *.ps1  - must stay UTF-8 with BOM (see below), CRLF keeps git diff quiet on Windows
#   *.R    - must stay UTF-8 WITHOUT BOM, Rscript reads the BOM as a token
#   *.rds  - binary (gzip/xz), any text normalization corrupts the file
#
# Default: normalize to LF in the repo, check out LF.
* text=auto eol=lf

# Windows-only entry points: cmd.exe / PowerShell want CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Site + scripts: always LF.
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.R    text eol=lf
*.txt  text eol=lf

# Never touch bytes.
*.rds  binary
*.pdf  binary
*.png  binary
*.jpg  binary

# Generated data: collapse in diffs, keep out of language stats.
samples/*.json linguist-generated=true
